-- ===== DRAG =====
do
	local dragging, dragStart, startPos
	header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

-- ===== FOLD =====
local folded = false
local fullSize = main.Size
fold.MouseButton1Click:Connect(function()
	folded = not folded
	body.Visible = not folded
	main.Size = folded and UDim2.fromOffset(220,40) or fullSize
	fold.Text = folded and "+" or "-"
end)

-- ===== TOGGLE =====
toggle.MouseButton1Click:Connect(function()
	AUTO = not AUTO
	toggle.Text = AUTO and "AUTO : ON" or "AUTO : OFF"
	toggle.BackgroundColor3 = AUTO and Color3.fromRGB(60,170,80)
		or Color3.fromRGB(170,60,60)

	if not AUTO then
		disableHover()
	end
end)

-- ===== AUTO ATTACK LOOP =====
task.spawn(function()
	while true do
		if AUTO and hrp and humanoid and humanoid.Health > 0 then
			local nearest, bestDist

			for _, m in ipairs(MobsFolder:GetChildren()) do
				if m:IsA("Model")
				and m:FindFirstChild("Humanoid")
				and m:FindFirstChild("HumanoidRootPart")
				and m.Humanoid.Health > 0 then

					local dist = (hrp.Position - m.HumanoidRootPart.Position).Magnitude
					if dist <= SAME_ZONE_DISTANCE then
						if not bestDist or dist < bestDist then
							bestDist = dist
							nearest = m
						end
					end
				end
			end

			if nearest then
				local cf = nearest.HumanoidRootPart.CFrame * CFrame.new(0, HEAD_OFFSET, 0)
				hrp.CFrame = cf
				enableHover(cf)

				pcall(function()
					CombatRemote:InvokeServer(
						SkillIndex,
						{nearest},
						HitType,
						HitDelay
					)
				end)
			end
		else
			disableHover()
		end
		task.wait(LOOP_DELAY)
	end
end)
